{
  "$schema": "https://biomejs.dev/schemas/latest/schema.json",
  "extends": ["@kumix/biome-config/base"],
  "files": {
    // Mirrors @kumix/biome-config/base includes (arrays replace on extends) + CHANGELOG exclusion.
    "includes": [
      // biome-ignore lint/suspicious/noBiomeFirstException: mirrors base config, arrays replace on extends
      "**",
      "!**/bun.lock",
      "!**/routeTree.gen.ts",
      "!**/CHANGELOG.md",
      "!!**/.changeset",
      "!!**/.cloudflare",
      "!!**/.husky",
      "!!**/.next",
      "!!**/.nitro",
      "!!**/.output",
      "!!**/.source",
      "!!**/.tanstack",
      "!!**/.turbo",
      "!!**/.wrangler",
      "!!**/build",
      "!!**/coverage",
      "!!**/dist",
      "!!**/dist-ssr",
      "!!**/generated",
      "!!**/node_modules",
      "!!**/out"
    ]
  },
  "overrides": [
    {
      "includes": ["packages/ui/src/components/ui/calendar.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noComponentHookFactories": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/ui/src/components/**"],
      "linter": {
        "rules": {
          "nursery": {
            "noTailwindRestyledComponents": "off",
            "noTailwindRawColors": "off"
          }
        }
      }
    }
  ]
}
