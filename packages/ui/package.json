{
  "name": "@kumix/ui",
  "version": "0.3.2",
  "description": "Kumix React UI kit: shadcn/ui (Base UI, base-nova) + ReUI components, Tailwind tokens, and hooks. Per-file ESM exports.",
  "author": "Kumix Labs <hai@kumix.io>",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./css": {
      "types": "./dist/style.css.d.ts",
      "default": "./dist/style.css"
    },
    "./theme": {
      "types": "./dist/theme.css.d.ts",
      "default": "./dist/theme.css"
    },
    "./*": {
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist",
    "clean:all": "rimraf .turbo dist node_modules",
    "dev": "tsdown --watch",
    "build:css": "cp src/style.css dist/style.css && cp src/theme.css dist/theme.css && cp src/style.css.d.ts dist/style.css.d.ts && cp src/theme.css.d.ts dist/theme.css.d.ts",
    "build": "rimraf dist && mkdir -p dist && bun run build:css && tsdown && publint",
    "types:check": "tsc --noEmit",
    "add:shadcn": "shadcn add --all --overwrite",
    "add:reui": "shadcn add @reui/alert @reui/autocomplete @reui/badge @reui/data-grid @reui/date-selector @reui/event-calendar @reui/use-file-upload @reui/filters @reui/frame @reui/gantt @reui/icon-stack @reui/icon-tile @reui/kanban @reui/number-field @reui/phone-input @reui/rating @reui/scrollspy @reui/sortable @reui/stepper @reui/timeline @reui/tree --overwrite",
    "add:beui:ai-agents": "shadcn add @beui/prompt-input @beui/todo-list @beui/code-block @beui/approval-card @beui/file-diff @beui/tool-result @beui/streaming-response @beui/image-generation @beui/tool-approval @beui/citations @beui/agent-activity @beui/reasoning-text @beui/thinking-shimmer @beui/agent-progress @beui/ai-sidebar @beui/chat-app @beui/message-bubble @beui/message @beui/message-scroller --overwrite",
    "add:beui:components": "shadcn add @beui/marquee @beui/tabs @beui/switch @beui/input @beui/select @beui/select-morph @beui/checkbox @beui/radio @beui/bottom-sheet @beui/pull-to-refresh @beui/shared-layout-bg @beui/bounce-sidebar @beui/animated-sidebar @beui/preview-rail @beui/dock @beui/tooltip @beui/context-menu @beui/popover @beui/popover-morph @beui/morphing-modal @beui/center-morph-modal @beui/chromatic-text-reveal @beui/text-reveal @beui/text-shimmer @beui/text-cascade @beui/number-ticker @beui/animated-number @beui/animated-badge @beui/action-swap-cascade @beui/action-swap-blur @beui/action-swap-roll @beui/animated-toast-stack @beui/theme-toggle @beui/bouncy-accordion @beui/drawer @beui/smooth-scroll @beui/scroll-progress @beui/parallax @beui/scroll-to @beui/scroll-reveal @beui/range-slider @beui/range-slider-fluid @beui/range-slider-wave @beui/range-slider-bubble @beui/range-slider-ruler @beui/wheel-picker @beui/table @beui/table-editable @beui/table-async @beui/shader-background @beui/cylinder-carousel @beui/loader @beui/tilt-card @beui/button-base @beui/button-stateful @beui/button-magnetic @beui/hold-action-button @beui/slide-action-button --overwrite",
    "add:beui:blocks": "shadcn add @beui/availability-scheduler @beui/dynamic-island @beui/command-palette @beui/expandable-action-bar @beui/overflow-actions @beui/expandable-tabs @beui/swipeable-list @beui/attachment-upload @beui/file-upload @beui/otp-input @beui/bloom-menu @beui/feedback-widget @beui/not-found-glitch @beui/not-found-magnetic @beui/not-found-spotlight @beui/not-found-stacked @beui/not-found-terminal @beui/infinite-masonry @beui/notification-stack --overwrite",
    "add:beui": "bun run add:beui:ai-agents && bun run add:beui:components && bun run add:beui:blocks"
  },
  "homepage": "https://github.com/kumixlabs/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kumixlabs/ui.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/kumixlabs/ui/issues"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "kumix",
    "react",
    "ui",
    "components",
    "shadcn",
    "reui",
    "base-ui",
    "tailwind",
    "tailwindcss",
    "hooks"
  ],
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@date-fns/tz": "^1.5.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@headless-tree/core": "^1.7.0",
    "@kumix/tsconfig": "^0.1.0",
    "@kumix/utils": "^0.1.3",
    "@paper-design/shaders-react": "^0.0.78",
    "@shadcn/react": "^0.3.0",
    "@tanstack/react-table": "^9.0.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/react": "^19.2.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lenis": "^1.3.26",
    "lucide-react": "^1.28.0",
    "motion": "^13.0.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-phone-number-input": "^3.4.17",
    "react-resizable-panels": "^4.12.2",
    "recharts": "3.10.1",
    "shiki": "^4.4.2",
    "tailwind-merge": "^3.6.0",
    "tsdown": "^0.22.14",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@base-ui/react": ">=1.7.0",
    "@date-fns/tz": ">=1.5.0",
    "@dnd-kit/core": ">=6.3.0",
    "@dnd-kit/modifiers": ">=9.0.0",
    "@dnd-kit/sortable": ">=10.0.0",
    "@dnd-kit/utilities": ">=3.2.0",
    "@headless-tree/core": ">=1.7.0",
    "@kumix/utils": ">=0.1.0",
    "@paper-design/shaders-react": ">=0.0.75",
    "@shadcn/react": ">=0.3.0",
    "@tanstack/react-table": ">=9.0.0",
    "@tanstack/react-virtual": ">=3.10.0",
    "class-variance-authority": ">=0.7.0",
    "cmdk": ">=1.1.0",
    "date-fns": ">=4.4.0",
    "embla-carousel-react": ">=8.6.0",
    "input-otp": ">=1.4.0",
    "lenis": ">=1.3.0",
    "lucide-react": ">=1.20.0",
    "motion": ">=13.0.0",
    "next-themes": ">=0.4.5",
    "react": ">=18.0.0 || >=19.0.0-rc.0",
    "react-day-picker": ">=10.0.0",
    "react-phone-number-input": ">=3.4.0",
    "react-resizable-panels": ">=4.10.0",
    "recharts": ">=3.9.0",
    "shiki": ">=4.4.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  }
}
